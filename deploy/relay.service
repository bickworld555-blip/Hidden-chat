[Unit]
Description=GoChat Relay Messenger
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/opt/relay/current
EnvironmentFile=/etc/relay/relay.env
ExecStart=/usr/bin/node server/main.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relay

[Install]
WantedBy=multi-user.target
