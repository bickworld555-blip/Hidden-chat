<?xml version="1.0" encoding="utf-8"?>
<!-- Recent chats in the top row of Android's share sheet (ShareShortcuts publishes them with this category). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="io.github.bickworld555.hiddenchat.AppActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
        <category android:name="io.github.bickworld555.hiddenchat.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
