# Hostinger VPS runtime: copy privately to /etc/relay/relay.env.
# Copy Supabase Connect's direct or SESSION pooler URI (5432), encoding the password.
# Remove sslmode/sslcert/sslkey/sslrootcert/ssl query parameters; TLS is owned below.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_DATABASE_PASSWORD@EXACT_SESSION_POOLER_HOST:5432/postgres
# Download the database CA from Supabase; use an absolute path on the VPS.
# May be omitted only if Node already trusts the endpoint's certificate.
# Accepts a PEM file path or the PEM certificate text itself.
DATABASE_SSL_CA=/etc/relay/supabase-ca.crt
DATABASE_POOL_MAX=5
NODE_ENV=production
HOST=127.0.0.1
PORT=4174
RELAY_ALLOWED_ORIGINS=https://chat.example.com
RELAY_SEED_DEMO=false
# Persistent attachments and avatars, not Supabase Storage.
RELAY_DATA_DIRECTORY=/var/lib/relay
# Configure your own TURN relay for calls across restrictive/mobile networks.
RELAY_TURN_URL=
RELAY_TURN_USERNAME=
RELAY_TURN_CREDENTIAL=
# Optional additional ICE servers (JSON array); returned only to logged-in clients.
RELAY_ICE_SERVERS=[]
# Optional call ringing timeout in milliseconds; 0 keeps existing behavior.
CALL_RING_TIMEOUT_MS=0
# server/main.mjs creates a missing database schema on startup; false requires npm run db:migrate.
RELAY_AUTO_MIGRATE=true

# Android build-time only: also set the GitHub repository variable ANDROID_APP_URL.
# This is the remote-URL shell's app origin, NOT an APK download URL.
ANDROID_APP_URL=https://chat.example.com

# No Supabase API keys are required: the browser uses /api and /ws.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and JWT_SECRET are NOT consumed.
# Sessions use random tokens hashed in the database, not JWTs.
# Never put database passwords or privileged Supabase keys in VITE_* variables.
# VITE_ALLOWED_HOSTS, VITE_TUNNEL_HOST and VITE_HMR_CLIENT_PORT are dev-only.
# Optional frontend build/dev setting for separate frontend/backend origins.
# Leave empty for same-origin /api and /ws. Never include secrets or /api paths.
VITE_API_BASE_URL=
