# Backend only. Copy the exact URI from Supabase Connect; encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Absolute path to the CA certificate downloaded from Supabase database settings.
DATABASE_SSL_CA=C:\certificates\prod-supabase.cer
DATABASE_POOL_MAX=5
NODE_ENV=production
HOST=127.0.0.1
PORT=4174
RELAY_ALLOWED_ORIGINS=https://chat.example.com
RELAY_SEED_DEMO=false
# Persistent local attachments and avatar photos; not a Supabase Storage bucket.
RELAY_DATA_DIRECTORY=C:\relay-data
# Configure your own TURN server before testing calls across mobile networks.
RELAY_TURN_URL=
RELAY_TURN_USERNAME=
RELAY_TURN_CREDENTIAL=

# No VITE_SUPABASE_* keys are required: the browser uses /api and /ws.
# Supabase URL, publishable/anon and secret/service_role keys are not used
# by this direct-PostgreSQL migration. Never place privileged keys in VITE_*.
